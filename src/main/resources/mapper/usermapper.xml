<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.routerecipt.project.mapper.UserMapper">
	<resultMap type="com.routerecipt.project.dto.Userdto" id="UserMap">
		<id property="u_id" column="u_id"/>
		<result property="u_pw" column="u_pw"/>
		<result property="u_birthday" column="u_birthday"/>
		<result property="u_email" column="u_email"/>
		<result property="u_date" column="u_date"/>
		<result property="gender" column="gender" javaType="com.routerecipt.project.dto.Userdto$Gender"/>
		<result property="role" column="role"/>
	</resultMap>
	
	<!-- 회원가입 -->
	<insert id="UserSignUp" parameterType="com.routerecipt.project.dto.Userdto">
		insert into routereciptdb.user values (
			#{u_id}, #{u_pw}, #{u_name}, #{u_birthday}, #{u_email}, NOW(), #{gender}, #{role}
		)
	</insert>
	
	<!-- Security 로그인에 필요한 기능 -->
	<select id="loadUserByUsername" parameterType="string" resultMap="UserMap">
		select * from routereciptdb.user where u_id = #{u_id}
	</select>
	
	<!-- 아이디 비밀번호 찾기 -->
	<select id="UserFind" parameterType="string" resultMap="UserMap">
		select u_id, u_pw from routereciptdb.user where u_email = #{u_email}
	</select>
	
	<!-- 회원정보보기 -->
	<select id="UserInfoShow" parameterType="com.routerecipt.project.dto.Userdto" resultMap="UserMap">
		select * from routereciptdb.user where u_id = #{_parameter}
	</select>
	
	<!-- 회원정보수정 -->
	<update id="UserInfoUpdate" parameterType="com.routerecipt.project.dto.Userdto">
		update routereciptdb.user set u_name = #{u_name}, u_pw = #{u_pw}, u_email = #{u_email}	
	</update>
	
	<!-- 회원탈퇴 -->
	<delete id="UserInfoDelete" parameterType="com.routerecipt.project.dto.Userdto">
		delete from routereciptdb.user where u_id = #{u_id}
	</delete>
	
</mapper>